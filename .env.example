# Settings for the API server (`pnpm api`). Copy this file to .env and change what you need;
# a variable left out, or left empty, keeps the value shown here.

# Where the server listens. 127.0.0.1 is this computer only; 0.0.0.0 opens it to other computers.
HOST=127.0.0.1
PORT=3000

# Requests to /api/resolve one client may make per minute (1 or more).
URLRESOLVE_RATE_LIMIT=30

# Links resolved at the same time by everyone together (1 or more); another request then gets
# "503 busy". One client can have at most 2 of them.
URLRESOLVE_MAX_CONCURRENT=8

# How long a resolved link is remembered, in seconds (0: nothing is), and how many links at most.
URLRESOLVE_CACHE_TTL_SECONDS=0
URLRESOLVE_CACHE_SIZE=1000

# 1 opens pages that need one in Chromium (run `pnpm install-browser` once first); 0 does not.
URLRESOLVE_BROWSER=0

# The address of the reverse proxy in front of the server, when there is one: 127.0.0.1 or
# "loopback" for a proxy on this computer, or its address or network (10.0.0.0/8). The rate limit
# then counts the client the proxy saw. Leave it empty without a proxy: then nobody can choose
# the address they are counted as.
URLRESOLVE_TRUST_PROXY=
